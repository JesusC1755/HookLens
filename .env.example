# Puerto del host para Postgres en Docker (cámbialo si ya usas el 5432)
POSTGRES_PORT=5432

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# URL pública del API (obligatoria en producción; en desarrollo usa http://localhost:PORT)
PUBLIC_BASE_URL=http://localhost:3001
# IPs/CIDR de los proxies de confianza, separadas por comas (vacío en local).
# Alias válidos: loopback, linklocal, uniquelocal y cloudflare (sus rangos oficiales).
# En Render: loopback,uniquelocal,cloudflare (Cloudflare → balanceador → proxy local).
TRUST_PROXY=
# Orígenes del front que pueden llamar a /api, separados por comas
# (obligatoria en producción; en desarrollo usa http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Solo desarrollo: permite que el replay llegue a localhost (127.0.0.0/8 y ::1) para
# reenviar a tu app local. Las demás redes privadas siguen bloqueadas.
# Con NODE_ENV=production el servidor se niega a arrancar si está en true.
REPLAY_ALLOW_LOOPBACK=false
# Retención por endpoint (requests y MB); en producción se bajan para caber en el plan de la base
RETENTION_MAX_REQUESTS=500
RETENTION_MAX_MB=50
# Cada cuántos minutos se borran los endpoints vencidos (cada pasada despierta a la base)
EXPIRATION_INTERVAL_MINUTES=10
# En una base remota (Neon) termina en ?sslmode=verify-full: verifica el certificado del
# servidor. Con sslmode=require, pg v9 dejará de verificarlo, y pg ignora channel_binding.
DATABASE_URL=postgres://hooklens:hooklens@localhost:5432/hooklens
DATABASE_URL_TEST=postgres://hooklens:hooklens@localhost:5432/hooklens_test

# El front tiene su propio archivo: apps/web/.env.example
