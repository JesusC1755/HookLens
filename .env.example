# Puerto del host para Postgres en Docker (cámbialo si ya usas el 5432)
POSTGRES_PORT=5432

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# URL pública del API (obligatoria en producción; en desarrollo usa http://localhost:PORT)
PUBLIC_BASE_URL=http://localhost:3001
# IPs/CIDR de los proxies de confianza, separadas por comas (vacío en local).
# Alias válidos: loopback, linklocal, uniquelocal. Se define al hacer el deploy.
TRUST_PROXY=
# Orígenes del front que pueden llamar a /api, separados por comas
# (obligatoria en producción; en desarrollo usa http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://hooklens:hooklens@localhost:5432/hooklens
DATABASE_URL_TEST=postgres://hooklens:hooklens@localhost:5432/hooklens_test
